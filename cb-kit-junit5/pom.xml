<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.cloudbeat</groupId>
        <artifactId>cb-kit-java</artifactId>
        <version>${revision}</version>
    </parent>

    <name>CloudBeat Kit for JUnit 5</name>
    <description>JUnit 5 integration library for CloudBeat</description>
    <url>https://github.com/cloudbeat-io/cb-kit-java/tree/main/cb-kit-junit5</url>

    <artifactId>cb-kit-junit5</artifactId>
    <packaging>jar</packaging>

    <properties>
        <junit.jupiter.version>5.9.1</junit.jupiter.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- CloudBeat -->
        <dependency>
            <groupId>io.cloudbeat</groupId>
            <artifactId>cb-kit-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- JUnit -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
        </dependency>
        <!-- Platform-level launcher API, needed for the TestExecutionListener that reports
             the full test plan as Pending before any test starts (see CbJunitExecutionListener).
             "provided": needed to compile this module, but must NOT be forced as a transitive,
             version-pinned dependency onto consumers - a consumer project resolving its own
             jupiter-engine as LATEST (as examples-java-junit does) would get a version-skewed,
             stale launcher otherwise, which breaks test discovery entirely ("TestEngine with ID
             'junit-jupiter' failed to discover tests"). Each consumer must supply its own
             matching junit-platform-launcher (e.g. also as LATEST, alongside its jupiter deps). -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.9.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
